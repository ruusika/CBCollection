{
	"schemaVersion": 1,
	"id": "cbcollection",
	"version": "${version}",
	"name": "Cookbook Collection (CBCollection)",
	"description": "A collection of Minecraft cooking mods cookbooks",
	"authors": [
		"Ruusika - dev",
        "JR1811 - dev",
		"Apfelrunder - art",
        "Mæxøn - english translations"
	],
	"contact": {
		"homepage": "https://github.com/ruusika",
		"sources": "https://github.com/ruusika/cookbook_collection"
	},
	"license": "MIT",
	"icon": "assets/cbcollection/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.ruusika.cbcollection.CBCollection"
		],
		"client": [
			"net.ruusika.cbcollection.CBCollectionClient"
		],
		"fabric-datagen": [
